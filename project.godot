; Car Idle — projet Godot 4.7

config_version=5

[application]

config/name="Car Idle"
config/description="Idle game de garage en 3D réaliste, balade en vue de drone."
run/main_scene="res://scenes/balade.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.8, 0.75, 0.67, 1)

[shader_globals]

night={
"type": "float",
"value": 0.0
}
head_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
head_power={
"type": "float",
"value": 1.0
}
head_side={
"type": "vec3",
"value": Vector3(0.6, 0, 0)
}
head_dir={
"type": "vec3",
"value": Vector3(0, 0, 1)
}
